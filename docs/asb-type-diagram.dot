on(self, hook: fn(&str) -\> Option\<collectors_GraphSection\>) Self\l+with_finish(self, hook: Session) -\> Result\<(), String\>) Self\l+with_lifecycle_event(self, hook: Session, LifecycleEvent) -\> Result\<(), String\>) Self\l}", shape=record];
