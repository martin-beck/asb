        "asb-cli_src_Session" [label="{Session|-dir: PathBuf\l-tool_dir: Option\<PathBuf\>\l-started_unix_ms: u128\l-collectors: Vec\<Collector\>\l-states: BTreeMap\<TypeId, Box\<dyn Any\>\>\l-shared_artifacts: BTreeMap\<collectors::SharedArtifact, PathBuf\>\l-run_started: bool\l-run_failed: bool\l-run_finishing: bool\l-lifecycle_started: Instant\l-lifecycle: Vec\<LifecycleRecord\>\l-test_attach_failure: bool\l-trace_id: String\l-sudo_collectors: BTreeSet\<String\>\l-component_starts: BTreeMap\<String, Instant\>\l-component_timings: BTreeMap\<String, ComponentTiming\>\l-process_sampler: Option\<ProcessSampler\>\l-process_tree_snapshots: Vec\<ProcessTreeSnapshot\>\l-clock_ticks_per_second: Option\<u64\>\l|+started_unix_ms() u128\l+start_with_collectors(dir: &Path, selected: &[String], tool_dir: Option\<&Path\>) Result\<Self, String\>\l+event(event: LifecycleEvent) Result\<(), String\>\l+record_component_event(event: LifecycleEvent) void\l+finish_component(name: &str, now: Instant) void\l+start_process_sampler(pid: u32) void\l+stop_process_sampler() void\l+write_component_measurements(elapsed_ms: u128) Result\<(), String\>\l+trace_id() &str\l+state() Rc\<RefCell\<T\>\>\l+set_artifact(kind: SharedArtifact, path: PathBuf) void\l+artifact(kind: SharedArtifact) Option\<&Path\>\l+attach_pid(pid: u32) Result\<(), String\>\l+finish(self, measurement: RunMeasurement\<'a\>) Result\<(), String\>\l+start_snapshot(name: &str, variable: &str, args: &[&str], enabled: bool, executable: &Path) Result\<(), String\>\l+command(name: &str) Command\l+executable(name: &str) PathBuf\l+stop_process_tree_snapshots() void\l}", shape=record];
